# Required for full analyzer/orchestrator runs.
OPENAI_API_KEY=

# Optional LangSmith tracing for OpenAI Agents SDK spans.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pr-report-agent
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ENDPOINT=

# Full PR diffs and comments are included in model prompts. Set false to keep
# span structure while omitting sensitive agent inputs and outputs.
PR_REPORT_TRACE_INCLUDE_SENSITIVE_DATA=true

# Optional chaos testing for observability UI failure states. Set to 0.1 for
# deterministic pseudo-random failures in about 10% of PR analyzer agent runs.
PR_REPORT_ANALYZER_FAILURE_RATE=0
PR_REPORT_ANALYZER_FAILURE_SEED=demo

# Optional chaos testing for tool-call error UI states. Set to 0.1 for
# deterministic pseudo-random tool failures in about 10% of PR analyzer runs.
PR_REPORT_TOOL_FAILURE_RATE=0
PR_REPORT_TOOL_FAILURE_SEED=demo

# Optional future Notion CLI unattended auth.
# Prefer `ntn login` locally when possible.
NOTION_API_TOKEN=
NOTION_WORKSPACE_ID=
