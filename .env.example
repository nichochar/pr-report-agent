# Required for full analyzer/orchestrator runs.
OPENAI_API_KEY=

# Optional Weave tracing for OpenAI Agents SDK spans and Weave Agents activity.
WANDB_API_KEY=
WEAVE_PROJECT=
WEAVE_PRINT_CALL_LINK=false
WEAVE_ENABLE_WAL=true

# Full PR diffs and comments are included in model prompts. Set false to keep
# span structure while omitting sensitive agent inputs and outputs.
PR_REPORT_TRACE_INCLUDE_SENSITIVE_DATA=true

# Weave Agents tool payloads are capped before OTLP export so large diffs or
# file reads do not make short-lived CLI flushes time out.
PR_REPORT_WEAVE_AGENT_PAYLOAD_MAX_CHARS=2000
PR_REPORT_WEAVE_OTEL_EXPORT_TIMEOUT_MS=120000
PR_REPORT_WEAVE_OTEL_MAX_EXPORT_BATCH_SIZE=32

# Optional raw OTel override. If unset, PR_REPORT_WEAVE_OTEL_EXPORT_TIMEOUT_MS
# is copied here before Weave initializes its GenAI exporter.
# OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=120000

# Telemetry comparison runs should fail loudly if Weave cannot flush spans.
# Set false only for artifact-only runs where telemetry loss is acceptable.
PR_REPORT_FAIL_ON_OBSERVABILITY_FLUSH_ERROR=true

# Optional chaos testing for observability UI failure states. Set to 0.1 for
# deterministic pseudo-random failures in about 10% of PR analyzer agent runs.
PR_REPORT_ANALYZER_FAILURE_RATE=0
PR_REPORT_ANALYZER_FAILURE_SEED=demo

# Optional chaos testing for tool-call error UI states. Set to 0.1 for
# deterministic pseudo-random tool failures in about 10% of PR analyzer runs.
PR_REPORT_TOOL_FAILURE_RATE=0
PR_REPORT_TOOL_FAILURE_SEED=demo

# Optional future Notion CLI unattended auth.
# Prefer `ntn login` locally when possible.
NOTION_API_TOKEN=
NOTION_WORKSPACE_ID=
